import re 
import json

# 1. Load the JSON dataset from your screenshot
with open('sample_faq.json', 'r') as f:
    data = json.load(f)

GREETINGS = data.get('greetings', [])
FAQS = data.get('faqs', [])

print("="*60)
print("Rule-Based Interactive Terminal Assistant - Task 4")
print("Type 'bye' / 'exit' / 'quit' to end")
print("="*60)

def normalize(text):
    return text.lower().strip()

def find_best_answer(user_input):
    user_input = normalize(user_input)
    matched_answers = []

    # Check greetings using regex
    for greet in GREETINGS:
        if re.search(r'\b' + re.escape(greet) + r'\b', user_input):
            matched_answers.append("Hello! I am your support assistant. How can I help?")
            break

    # Check FAQs using keywords + regex
    for faq in FAQS:
        question = faq['question'].lower()
        # extract keywords from question (3+ letter words)
        keywords = re.findall(r'\b\w{3,}\b', question)
        for kw in keywords:
            if re.search(r'\b' + re.escape(kw) + r'\b', user_input):
                matched_answers.append(faq['answer'])
                break
    
    return matched_answers

# Conversational State Loop
while True:
    try:
        user = input("\nYou: ")
        if not user.strip():
            continue

        # Exit commands
        if normalize(user) in ['bye', 'exit', 'quit', 'goodbye']:
            print("Bot: Goodbye! All the best for your internship.")
            break

        answers = find_best_answer(user)

        # Multi-intent + Fallback handling
        if answers:
            # Remove duplicates
            answers = list(dict.fromkeys(answers))
            for ans in answers:
                print(f"Bot: {ans}")
        else:
            print("Bot: Sorry, I didn't understand. You can ask me:")
            print(" - What are your hours of operation?")
            print(" - How do I submit my internship project?")
            print(" - When will I receive my certificate?")

    except Exception as e:
        print(f"Bot: Error - {e}")